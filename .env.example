# Composio Research Agent Environment Configuration
# Copy this file to .env and fill in your keys

# 1. Composio API Key (https://app.composio.dev/settings)
COMPOSIO_API_KEY=

# 2. LLM Provider (OpenAI, Anthropic, or OpenRouter)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# 3. Optional Search & Scraping Addons (Handled automatically by Composio Toolset if left blank)
FIRECRAWL_API_KEY=
TAVILY_API_KEY=

# 4. Pipeline Execution Mode ('live' to execute queries, 'cached' to load local high-fidelity dataset)
RESEARCH_MODE=cached
